  <rdf:type rdf:resource="#Incident"/>
  <affects rdf:resource="#order_queue"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#inc_004">
  <rdf:type rdf:resource="#Incident"/>
  <affects rdf:resource="#search_service"/>
</owl:NamedIndividual>

<owl:AllDifferent>
  <owl:distinctMembers rdf:parseType="Collection">
    <rdf:Description rdf:about="#storefront_team"/>
    <rdf:Description rdf:about="#payments_team"/>
    <rdf:Description rdf:about="#platform_team"/>
    <rdf:Description rdf:about="#cloudwatch"/>
